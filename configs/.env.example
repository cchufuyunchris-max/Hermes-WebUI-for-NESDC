# Runtime
APP_ENV=local
APP_BASE_URL=http://localhost:8000
PUBLIC_BASE_PATH=/
PORT=8080

# User data inside each hermes-runtime container
HERMES_USER_ID=local-user
HERMES_USER_NAME=Local User
HERMES_DATA_DIR=/home/hermes/data
HERMES_WORKSPACE_DIR=/home/hermes/data/workspace
HERMES_MEMORY_DIR=/home/hermes/data/memory
HERMES_SESSION_DIR=/home/hermes/data/sessions
HERMES_ARTIFACT_DIR=/home/hermes/data/artifacts
HERMES_USER_SKILLS_DIR=/home/hermes/data/skills
HERMES_SKILL_STATE_FILE=/home/hermes/data/skill-state.json

# Recommended skills maintained by administrators.
# If HERMES_HOST_PROVISIONED_SKILLS_ROOT is set on JupyterHub, it is mounted
# read-only into each user container as HERMES_PROVISIONED_SKILLS_DIR.
HERMES_PROVISIONED_SKILLS_DIR=/home/hermes/provisioned-skills
HERMES_HOST_PROVISIONED_SKILLS_ROOT=/absolute/host/path/to/hermes/recommended-skills
HERMES_AUTO_INSTALL_RECOMMENDED_SKILLS=false
PROJECT_SKILLS_UPDATE_POLICY=manual

# Admin-controlled model gateway.
# Hermes Runtime should connect to this gateway only. The gateway decides whether
# a request can use the local private model or an online public model.
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=http://host.docker.internal:3001/v1
MODEL_API_KEY=change-me
MODEL_DEFAULT=default-model
HERMES_MODEL_POLICY_MODE=local-only
HERMES_PRIVATE_MODEL_ID=local-private-default
HERMES_PUBLIC_MODEL_ID=online-public-default
HERMES_MODEL_TIER_SAFE_MODEL=local-private-default
HERMES_MODEL_TIER_QUALITY_MODEL=local-private-default
HERMES_MODEL_TIER_FAST_MODEL=local-private-default
HERMES_MODEL_GATEWAY_PROVIDER=
HERMES_PRIVACY_TOOL_NAMES=clickhouse,postgres,sqlite,database,mcp_clickhouse
HERMES_ALLOW_USER_MODEL_SETTINGS=false
HERMES_ALLOW_USER_ONLINE_MODEL_API_KEY=false
HERMES_RUNTIME_PRIVACY_GUARD_ENABLED=true
HERMES_ONLINE_MODEL_ALLOWED_TOOLSETS=web,vision,clarify,todo,image_gen
HERMES_PRIVATE_TOOL_NAMES=terminal,process,read_terminal,execute_code,read_file,write_file,patch,search_files,memory,session_search,skill_manage,cronjob,delegate_task,send_message,browser_navigate,browser_snapshot,browser_click,browser_type,browser_scroll,browser_back,browser_press,browser_get_images,browser_vision,browser_console,browser_cdp,browser_dialog,computer_use
HERMES_PUBLIC_MCP_TOOL_PREFIXES=
HERMES_ALLOW_TERMINAL_NETWORK=false
HERMES_ALLOW_CODE_NETWORK=false
HERMES_ALLOWED_DATA_CONNECTORS=dify-public,clickhouse-readonly
HERMES_DATA_CONNECTORS_JSON=
HERMES_DATA_AUDIT_ENABLED=true
HERMES_DATA_AUDIT_LOG_PATH=/home/hermes/data/audit/data-tools.jsonl
HERMES_MANAGED_MCP_SERVERS_JSON=
HERMES_ENFORCE_MANAGED_MCP_SERVERS=true

# Dify / knowledge base.
# Set DIFY_PRIVACY_LEVEL=public for non-sensitive retrieval. Use private only
# when the Dify deployment and model path are fully internal.
DIFY_BASE_URL=http://host.docker.internal:5001
DIFY_API_KEY=change-me
DIFY_APP_ID=change-me
DIFY_PRIVACY_LEVEL=public

# Private database access, preferably exposed through an internal MCP service.
CLICKHOUSE_HOST=clickhouse.internal
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=readonly
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_PRIVACY_LEVEL=private
CLICKHOUSE_ACCESS_MODE=read-only
CLICKHOUSE_READONLY=1

# JupyterHub / DockerSpawner
JUPYTERHUB_BASE_URL=/
JUPYTERHUB_DEFAULT_URL=/hub/home
JUPYTERHUB_AUTH_MODE=native
JUPYTERHUB_ALLOW_ALL=true
JUPYTERHUB_OPEN_SIGNUP=true
DOCKER_NETWORK_NAME=hermes-net
HERMES_RUNTIME_IMAGE=hermes-runtime:local
HERMES_USER_DATA_ROOT=/srv/hermes/users
HERMES_HOST_USER_DATA_ROOT=/absolute/host/path/to/hermes/users
HERMES_CONTAINER_MEMORY_LIMIT=4g
HERMES_CONTAINER_CPU_LIMIT=2
HERMES_POLICY_ROOT=/srv/hermes/policies
HERMES_HOST_POLICY_ROOT=/srv/hermes/policies

# Platform OAuth SSO. Used only when JUPYTERHUB_AUTH_MODE=oauth.
# The userinfo response must expose a stable user id field; use id by default.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
OAUTH_USERDATA_URL=
OAUTH_USERDATA_METHOD=GET
OAUTH_USERNAME_KEY=id
OAUTH_LOGIN_SERVICE=Main Platform
OAUTH_SCOPE=openid,profile
OAUTH_CALLBACK_URL=

# WebUI first-run defaults
HERMES_WEBUI_DEFAULT_THEME=light
HERMES_WEBUI_DEFAULT_LANGUAGE=zh

# Security
TRUSTED_ORIGINS=http://localhost:8000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
ENABLE_SANDBOX=false
SANDBOX_API_URL=http://sandbox-controller:9000
