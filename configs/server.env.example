# Hermes server deployment environment
#
# Copy to configs/server.env on the server and edit values:
#   cp configs/server.env.example configs/server.env
#
# Do not commit real server.env files.

COMPOSE_PROJECT_NAME=hermes

# Bind ports. If a reverse proxy terminates TLS, keep these private to the host
# or internal network and expose the proxy instead.
HERMES_JUPYTERHUB_BIND=127.0.0.1
HERMES_JUPYTERHUB_PORT=8000
HERMES_ADMIN_BIND=127.0.0.1
HERMES_ADMIN_PORT=8001

# Public URLs
JUPYTERHUB_URL=https://hermes.example.com
HERMES_ADMIN_URL=https://hermes-admin.example.com

# Host paths on the Hermes server
HERMES_PROJECT_ROOT=/srv/hermes/app
HERMES_HOST_USER_DATA_ROOT=/srv/hermes/users
HERMES_HOST_PROVISIONED_SKILLS_ROOT=/srv/hermes/app/skills
HERMES_HOST_POLICY_ROOT=/srv/hermes/policies
HERMES_HOST_JUPYTERHUB_DATA_ROOT=/srv/hermes/jupyterhub
HERMES_HOST_ADMIN_DATA_ROOT=/srv/hermes/admin

# Admin security. Replace before deployment.
HERMES_ADMIN_PASSWORD=change-me
HERMES_ADMIN_API_TOKEN=change-me

# Runtime / WebUI defaults
APP_ENV=production
HERMES_WEBUI_DEFAULT_THEME=light
HERMES_WEBUI_DEFAULT_LANGUAGE=zh
HERMES_WEBUI_ONBOARDING_OPEN=0

# Platform OAuth SSO
JUPYTERHUB_AUTH_MODE=oauth
JUPYTERHUB_ADMIN_USERS=admin
JUPYTERHUB_ALLOW_ALL=true
JUPYTERHUB_OPEN_SIGNUP=false
JUPYTERHUB_BASE_URL=/
JUPYTERHUB_DEFAULT_URL=/hub/home
JUPYTERHUB_ADMIN_API_TOKEN=
HERMES_SMOKE_USER=smoke
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
OAUTH_USERDATA_URL=
OAUTH_USERDATA_METHOD=GET
OAUTH_USERNAME_KEY=id
OAUTH_LOGIN_SERVICE=Main Platform
OAUTH_SCOPE=openid,profile
OAUTH_CALLBACK_URL=https://hermes.example.com/hub/oauth_callback

# Runtime image
HERMES_RUNTIME_IMAGE=hermes-runtime:local
DOCKER_NETWORK_NAME=hermes-net

# Admin local/private model default. Admin policy can override these.
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=http://model-gateway.internal:3001/v1
MODEL_API_KEY=
MODEL_DEFAULT=local-private-default

# Optional default connector endpoints. Prefer configuring real connectors in
# Admin policy so secrets can be managed and audited centrally.
DIFY_BASE_URL=
DIFY_API_KEY=
DIFY_APP_ID=
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=
CLICKHOUSE_USER=readonly
CLICKHOUSE_PASSWORD=
