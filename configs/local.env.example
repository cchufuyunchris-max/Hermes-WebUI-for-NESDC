# Hermes local test environment
#
# Copy to configs/local.env before running local scripts:
#   cp configs/local.env.example configs/local.env
#
# The scripts in scripts/ will create configs/local.env automatically when it
# does not exist. Keep configs/local.env out of version control.

COMPOSE_PROJECT_NAME=hermeswebui

# Local ports
HERMES_JUPYTERHUB_PORT=8000
HERMES_ADMIN_PORT=8001

# Host paths. For local development these must be absolute because
# JupyterHub/DockerSpawner passes them to sibling user containers.
HERMES_PROJECT_ROOT="/absolute/path/to/Hermes WebUI"
HERMES_HOST_USER_DATA_ROOT="/absolute/path/to/Hermes WebUI/.data/users"
HERMES_HOST_PROVISIONED_SKILLS_ROOT="/absolute/path/to/Hermes WebUI/skills"
HERMES_HOST_POLICY_ROOT="/absolute/path/to/Hermes WebUI/configs/policies"
HERMES_HOST_JUPYTERHUB_DATA_ROOT="/absolute/path/to/Hermes WebUI/.data/jupyterhub"
HERMES_HOST_ADMIN_DATA_ROOT="/absolute/path/to/Hermes WebUI/.data/admin"

# Admin login for local test only
HERMES_ADMIN_PASSWORD=local-admin
HERMES_ADMIN_API_TOKEN=local-admin

# Runtime / WebUI defaults
APP_ENV=local
HERMES_WEBUI_DEFAULT_THEME=light
HERMES_WEBUI_DEFAULT_LANGUAGE=zh
HERMES_WEBUI_ONBOARDING_OPEN=1

# JupyterHub local auth
JUPYTERHUB_AUTH_MODE=native
JUPYTERHUB_ADMIN_USERS=admin
JUPYTERHUB_ALLOW_ALL=true
JUPYTERHUB_OPEN_SIGNUP=true
JUPYTERHUB_BASE_URL=/
JUPYTERHUB_DEFAULT_URL=/hub/home
JUPYTERHUB_ADMIN_API_TOKEN=local-jupyterhub-admin-token
HERMES_SMOKE_USER=smoke

# Runtime image
HERMES_RUNTIME_IMAGE=hermes-runtime:local
DOCKER_NETWORK_NAME=hermes-net

# Optional local model endpoint. Admin policy can override these.
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=http://host.docker.internal:3001/v1
MODEL_API_KEY=
MODEL_DEFAULT=local-private-default

# Local URLs used by smoke tests
JUPYTERHUB_URL=http://127.0.0.1:8000
HERMES_ADMIN_URL=http://127.0.0.1:8001
